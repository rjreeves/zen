// Copy Dropbox credentials from the process environment into Zen secrets.
//
// Supported environment variables:
// - DROPBOX_TOKEN
// - DROPBOX_REFRESH_TOKEN with DROPBOX_APP_KEY or DROPBOX_CLIENT_ID
// - optional DROPBOX_APP_SECRET or DROPBOX_CLIENT_SECRET

requires {
  secrets.write
}

dropbox.secrets.save | select saved, names
