/target
# Workspace member crates (zen-lang, zen-cli, ...) whose test code
# resolves scratch dirs relative to their own crate dir (`cargo test -p`
# sets cwd there), rather than the shared workspace-root /target.
target/
/target_smoke
/dist
bin/
obj/
.zen/runtime.db
.zen/state.json
.zen/schedules.json
.zen/events.log
.zen/build-number
# build.rs now lives in zen-cli/, so its build-number counter lands in
# zen-cli/.zen/ rather than the repo root - the patterns above are
# anchored to repo root (a mid-pattern slash in gitignore does that),
# so also match any depth explicitly.
**/.zen/build-number
